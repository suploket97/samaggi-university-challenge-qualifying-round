# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (database page → REST API)
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional: a fixed host password. Leave unset to create one on the first visit to /admin.
# ADMIN_PASSWORD=

# Optional: secret for signing cookies and team tokens (defaults to one derived from the values above)
# SESSION_SECRET=
